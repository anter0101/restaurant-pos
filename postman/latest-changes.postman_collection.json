{
  "info": {
    "name": "Restaurant POS — Latest Changes",
    "description": "Delivery regions, orders (queue 0–100), and shift management. Import alongside the main collection or merge folders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "branchId", "value": "1" },
    { "key": "cashierId", "value": "1" },
    { "key": "shiftId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "deliveryRegionId", "value": "1" },
    { "key": "menuItemId", "value": "1" }
  ],
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "Login (save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('accessToken', json.token);",
                  "  pm.test('Token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "delivery-regions",
      "description": "Per-branch delivery zones with pricing",
      "item": [
        {
          "name": "List delivery regions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/delivery-regions?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "delivery-regions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create delivery region",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"regionName\": \"Downtown\",\n  \"deliveryPrice\": 5.5\n}"
            },
            "url": "{{baseUrl}}/api/v1/delivery-regions"
          }
        },
        {
          "name": "Get delivery region by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/delivery-regions/{{deliveryRegionId}}"
          }
        },
        {
          "name": "Update delivery region",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regionName\": \"Downtown Updated\",\n  \"deliveryPrice\": 6.0\n}"
            },
            "url": "{{baseUrl}}/api/v1/delivery-regions/{{deliveryRegionId}}"
          }
        },
        {
          "name": "Delete delivery region",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/delivery-regions/{{deliveryRegionId}}"
          }
        }
      ]
    },
    {
      "name": "shift-managements",
      "description": "Open/close shifts; resets branch order queue (0–100) on open and end",
      "item": [
        {
          "name": "Open shift",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('shiftId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"cashierId\": {{cashierId}},\n  \"notes\": \"Morning shift\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/shift-managements/open"
          }
        },
        {
          "name": "Get shift by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/shift-managements/{{shiftId}}"
          }
        },
        {
          "name": "End shift",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endMoney\": 1250.75,\n  \"notes\": \"Closed successfully\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/shift-managements/{{shiftId}}/end"
          }
        }
      ]
    },
    {
      "name": "orders",
      "description": "Creates orders with price snapshots and auto-assigned orderQueue (0–100, wraps, resets on shift)",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('orderId', String(json.id));",
                  "pm.test('orderQueue in range 0-100', () => {",
                  "  pm.expect(json.orderQueue).to.be.at.least(0);",
                  "  pm.expect(json.orderQueue).to.be.at.most(100);",
                  "});",
                  "pm.test('Has snapshot totals', () => {",
                  "  pm.expect(json).to.have.property('itemsSubtotal');",
                  "  pm.expect(json).to.have.property('serviceFee');",
                  "  pm.expect(json).to.have.property('totalAmount');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"shiftManagementId\": {{shiftId}},\n  \"deliveryRegionId\": {{deliveryRegionId}},\n  \"items\": [\n    { \"menuItemId\": {{menuItemId}}, \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        }
      ]
    }
  ]
}
