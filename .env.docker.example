# Copy to `.env.docker` and use with the full stack file:
#   docker compose -f docker-compose.full.yml --env-file .env.docker up --build
#
# For local DB only (frontend / API dev), use root `docker-compose.yml` and `pnpm run dev:db`.
APP_SECRET_KEY=change-me-set-a-long-random-secret-for-production
DATABASE_NAME=restaurant-pos
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT_PUBLISH=5432
HTTP_PORT=80
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=true
